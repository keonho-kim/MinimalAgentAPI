[serving]
mount_ui=true

[fs]
workspace="./tmpWorkspace/"
max_file_size=512

[llm]
provider="openai-compatible"
base_url="http://127.0.0.1:1234"
model_name="google/gemma-4-31B-it"
api_key="EMPTY"
max_tokens=12800
tls_verify=false

[llm.kwargs.extra_body]
enable_thinking=true

# Provider examples:
#
# OpenAI-compatible API (vLLM, Ollama, LM Studio, LiteLLM)
# provider="openai-compatible"
# base_url="http://localhost:8000/v1"
# model_name="local-model"
# api_key="EMPTY"
#
# OpenAI
# provider="openai"
# model_name="gpt-4.1-mini"
# api_key="sk-..."
#
# Google Gemini
# provider="google"
# model_name="gemini-2.5-flash"
# api_key="..."

# Anthropic Claude
# provider="anthropic"
# model_name="claude-3-5-sonnet-latest"
# api_key="..."
#
# [llm.kwargs]
# temperature=0.2
# top_p=0.9

[llm.summary]
trigger_token_size=4096
keep_messages=20
